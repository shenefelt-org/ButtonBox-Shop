<% content_for :title, "#{@product.title} · ButtonBox" %>

<div class="max-w-3xl mx-auto px-4 py-8 sm:py-12">
  <!-- Back Navigation to Shop Index -->
  <div class="mb-6">
    <%= link_to shop_index_path, class: "inline-flex items-center gap-2.5 text-sm font-semibold text-nav-muted hover:text-periwinkle transition" do %>
      <span class="w-4 h-4 rounded-full bg-[#A3C944] border border-[#82A62D] flex items-center justify-center shrink-0">
        <span class="grid grid-cols-2 gap-0.5">
          <span class="w-0.5 h-0.5 rounded-full bg-[#526B13]"></span>
          <span class="w-0.5 h-0.5 rounded-full bg-[#526B13]"></span>
          <span class="w-0.5 h-0.5 rounded-full bg-[#526B13]"></span>
          <span class="w-0.5 h-0.5 rounded-full bg-[#526B13]"></span>
        </span>
      </span>
      <span>Back to Products</span>
    <% end %>
  </div>

  <!-- Product Detail Card -->
  <div class="bg-white border border-surface-border rounded-2xl shadow-[0_8px_30px_rgba(104,95,214,0.08)] p-6 sm:p-10 relative overflow-hidden">
    
    <!-- Header Accent Bar -->
    <div class="flex items-center justify-between gap-4 mb-6 pb-6 border-b border-surface-border">
      
      <!-- Sewing Button Row Accents -->
      <div class="flex items-center gap-1.5">
        <!-- Chartreuse Button -->
        <div class="w-5 h-5 rounded-full bg-[#A3C944] border border-[#82A62D] shadow-sm flex items-center justify-center">
          <div class="grid grid-cols-2 gap-0.5">
            <div class="w-0.5 h-0.5 rounded-full bg-[#526B13]"></div>
            <div class="w-0.5 h-0.5 rounded-full bg-[#526B13]"></div>
            <div class="w-0.5 h-0.5 rounded-full bg-[#526B13]"></div>
            <div class="w-0.5 h-0.5 rounded-full bg-[#526B13]"></div>
          </div>
        </div>
        <!-- Periwinkle Button -->
        <div class="w-6 h-6 rounded-full bg-periwinkle border border-periwinkle-dark shadow-sm flex items-center justify-center">
          <div class="grid grid-cols-2 gap-0.5">
            <div class="w-0.5 h-0.5 rounded-full bg-[#2D2B4A]"></div>
            <div class="w-0.5 h-0.5 rounded-full bg-[#2D2B4A]"></div>
            <div class="w-0.5 h-0.5 rounded-full bg-[#2D2B4A]"></div>
            <div class="w-0.5 h-0.5 rounded-full bg-[#2D2B4A]"></div>
          </div>
        </div>
        <!-- Vermillion Button -->
        <div class="w-5 h-5 rounded-full bg-[#E34234] border border-[#B82B1F] shadow-sm flex items-center justify-center">
          <div class="grid grid-cols-2 gap-0.5">
            <div class="w-0.5 h-0.5 rounded-full bg-[#5C110A]"></div>
            <div class="w-0.5 h-0.5 rounded-full bg-[#5C110A]"></div>
            <div class="w-0.5 h-0.5 rounded-full bg-[#5C110A]"></div>
            <div class="w-0.5 h-0.5 rounded-full bg-[#5C110A]"></div>
          </div>
        </div>
      </div>

      <!-- Active Status Badge -->
      <div>
        <% if @product.active %>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-[#A3C944]/15 text-[#526B13] border border-[#82A62D]/30">
            <span class="w-2 h-2 rounded-full bg-[#82A62D]"></span>
            Active
          </span>
        <% else %>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-gray-100 text-nav-muted border border-surface-border">
            <span class="w-2 h-2 rounded-full bg-gray-400"></span>
            Inactive
          </span>
        <% end %>
      </div>
    </div>

    <!-- Product Title & Converted Price -->
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-4 mb-6">
      <div>
        <span class="text-xs font-extrabold uppercase tracking-wider text-nav-muted">Item #<%= @product.id %></span>
        <h1 class="text-2xl sm:text-3xl font-bold text-surface-text mt-1 tracking-tight">
          <%= @product.title %>
        </h1>
      </div>

      <!-- Price Converted from Cents -->
      <div class="bg-surface-bg border border-surface-border px-5 py-3 rounded-xl text-left md:text-right self-start">
        <span class="block text-xs font-semibold text-nav-muted uppercase">Price</span>
        <span class="text-2xl font-extrabold text-periwinkle-dark">
          <%= number_to_currency(@product.price_in_cents / 100.0) %>
        </span>
      </div>
    </div>

    <!-- Description -->
    <div class="mb-8">
      <h2 class="text-xs font-extrabold uppercase tracking-wider text-nav-muted mb-2">Description</h2>
      <div class="bg-surface-bg/50 border border-surface-border rounded-xl p-5 text-surface-text text-sm sm:text-base leading-relaxed">
        <%= @product.description.presence || "No description provided." %>
      </div>
    </div>

    <!-- Action Controls -->
    <div class="flex flex-wrap items-center justify-between gap-4 pt-6 border-t border-surface-border">
      
      <!-- Edit Item Link -->
      <%= link_to edit_product_path(@product), class: "inline-flex items-center gap-2.5 bg-periwinkle hover:bg-periwinkle-dark text-white font-semibold px-5 py-2.5 rounded-xl transition shadow-sm text-sm" do %>
        <span class="w-4 h-4 rounded-full bg-white/20 border border-white/40 flex items-center justify-center shrink-0">
          <span class="grid grid-cols-2 gap-0.5">
            <span class="w-0.5 h-0.5 rounded-full bg-white"></span>
            <span class="w-0.5 h-0.5 rounded-full bg-white"></span>
            <span class="w-0.5 h-0.5 rounded-full bg-white"></span>
            <span class="w-0.5 h-0.5 rounded-full bg-white"></span>
          </span>
        </span>
        <span>Edit Item</span>
      <% end %>

      <!-- Delete Product Button -->
      <%= button_to product_path(@product), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this item?" }, class: "inline-flex items-center gap-2 text-xs text-red-500 hover:text-red-700 font-semibold px-3 py-2 rounded-lg transition border border-transparent hover:border-red-200 cursor-pointer" do %>
        <span class="w-3.5 h-3.5 rounded-full bg-[#E34234] border border-[#B82B1F] flex items-center justify-center shrink-0">
          <span class="grid grid-cols-2 gap-0.5">
            <span class="w-0.5 h-0.5 rounded-full bg-[#5C110A]"></span>
            <span class="w-0.5 h-0.5 rounded-full bg-[#5C110A]"></span>
            <span class="w-0.5 h-0.5 rounded-full bg-[#5C110A]"></span>
            <span class="w-0.5 h-0.5 rounded-full bg-[#5C110A]"></span>
          </span>
        </span>
        <span>Delete Product</span>
      <% end %>

    </div>

  </div>
</div>