<%= form_with(model: product, class: "space-y-6") do |form| %>
  <% if product.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl text-sm mb-6">
      <h2 class="font-bold mb-1"><%= pluralize(product.errors.count, "error") %> prohibited this product from being saved:</h2>
      <ul class="list-disc list-inside text-xs space-y-1">
        <% product.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Product Title -->
  <div>
    <%= form.label :title, "Product Title", class: "block text-xs font-bold uppercase tracking-wider text-nav-muted mb-2" %>
    <%= form.text_field :title, placeholder: "e.g., Custom Enamel Button Badge", required: true, class: "w-full px-4 py-3 bg-surface-bg border border-surface-border rounded-xl text-surface-text placeholder:text-nav-muted focus:outline-none focus:ring-2 focus:ring-periwinkle focus:border-periwinkle transition text-sm" %>
  </div>

  <!-- Description -->
  <div>
    <%= form.label :description, "Description", class: "block text-xs font-bold uppercase tracking-wider text-nav-muted mb-2" %>
    <%= form.text_area :description, rows: 4, placeholder: "Describe your product or service...", class: "w-full px-4 py-3 bg-surface-bg border border-surface-border rounded-xl text-surface-text placeholder:text-nav-muted focus:outline-none focus:ring-2 focus:ring-periwinkle focus:border-periwinkle transition text-sm" %>
  </div>

  <!-- Price in Dollars -->
  <div>
    <%= form.label :price_in_dollars, "Price ($)", class: "block text-xs font-bold uppercase tracking-wider text-nav-muted mb-2" %>
    <div class="relative rounded-xl shadow-sm">
      <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4">
        <span class="text-nav-muted text-sm font-semibold">$</span>
      </div>
      <%= form.number_field :price_in_dollars,
          value: (product.price_in_cents ? number_with_precision(product.price_in_cents / 100.0, precision: 2) : nil),
          step: "0.01",
          min: "0",
          placeholder: "25.00",
          required: true,
          class: "w-full pl-8 pr-4 py-3 bg-surface-bg border border-surface-border rounded-xl text-surface-text placeholder:text-nav-muted focus:outline-none focus:ring-2 focus:ring-periwinkle focus:border-periwinkle transition text-sm" %>
    </div>
  </div>

  <!-- Active Switch -->
  <div class="flex items-center gap-3 pt-2">
    <%= form.check_box :active, class: "w-4 h-4 text-periwinkle bg-surface-bg border-surface-border rounded focus:ring-periwinkle focus:ring-2 cursor-pointer" %>
    <%= form.label :active, "Active in Inventory", class: "text-sm font-semibold text-surface-text cursor-pointer" %>
  </div>

  <!-- Dynamic Cancel Path Logic -->
  <% cancel_path = product.persisted? ? product_path(product) : shop_index_path %>

  <!-- Submit / Cancel Controls -->
  <div class="pt-6 border-t border-surface-border flex items-center justify-end gap-3">
    <%= link_to "Cancel", cancel_path, class: "text-xs text-nav-muted hover:text-surface-text font-semibold px-4 py-2 transition no-underline" %>
    
    <button type="submit" class="inline-flex items-center gap-2.5 bg-periwinkle hover:bg-periwinkle-dark text-white font-semibold px-6 py-2.5 rounded-xl transition shadow-sm text-sm cursor-pointer border-0">
      <span class="w-4 h-4 rounded-full bg-white/20 border border-white/40 flex items-center justify-center shrink-0">
        <span class="grid grid-cols-2 gap-0.5">
          <span class="w-0.5 h-0.5 rounded-full bg-white"></span>
          <span class="w-0.5 h-0.5 rounded-full bg-white"></span>
          <span class="w-0.5 h-0.5 rounded-full bg-white"></span>
          <span class="w-0.5 h-0.5 rounded-full bg-white"></span>
        </span>
      </span>
      <span>Save Product</span>
    </button>
  </div>
<% end %>