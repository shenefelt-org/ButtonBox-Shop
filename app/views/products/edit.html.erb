<% content_for :title, "Edit #{@product.title} · ButtonBox" %>

<div class="max-w-3xl mx-auto px-4 py-8 sm:py-12">
  <!-- Navigation Header: Products Link & Destroy Button -->
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <!-- Back to Products Link -->
    <%= link_to shop_index_path, class: "inline-flex items-center gap-2.5 text-sm font-semibold text-nav-muted hover:text-periwinkle transition no-underline" do %>
      <span class="w-4 h-4 rounded-full bg-[#A3C944] border border-[#82A62D] flex items-center justify-center shrink-0">
        <span class="grid grid-cols-2 gap-0.5">
          <span class="w-0.5 h-0.5 rounded-full bg-[#526B13]"></span>
          <span class="w-0.5 h-0.5 rounded-full bg-[#526B13]"></span>
          <span class="w-0.5 h-0.5 rounded-full bg-[#526B13]"></span>
          <span class="w-0.5 h-0.5 rounded-full bg-[#526B13]"></span>
        </span>
      </span>
      <span>Back to Products</span>
    <% end %>

    <!-- Destroy Button with Vermillion Danger Sewing Accent -->
    <%= button_to product_path(@product), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this product?" }, class: "inline-flex items-center gap-2 text-xs text-red-500 hover:text-red-700 font-semibold px-3 py-1.5 rounded-lg transition border border-transparent hover:border-red-200 cursor-pointer" do %>
      <span class="w-3.5 h-3.5 rounded-full bg-[#E34234] border border-[#B82B1F] flex items-center justify-center shrink-0">
        <span class="grid grid-cols-2 gap-0.5">
          <span class="w-0.5 h-0.5 rounded-full bg-[#5C110A]"></span>
          <span class="w-0.5 h-0.5 rounded-full bg-[#5C110A]"></span>
          <span class="w-0.5 h-0.5 rounded-full bg-[#5C110A]"></span>
          <span class="w-0.5 h-0.5 rounded-full bg-[#5C110A]"></span>
        </span>
      </span>
      <span>Delete Product</span>
    <% end %>
  </div>

  <div class="bg-white border border-surface-border rounded-2xl shadow-[0_8px_30px_rgba(104,95,214,0.08)] p-6 sm:p-10 relative overflow-hidden">
    <!-- Header -->
    <div class="flex items-center justify-between gap-4 mb-8 pb-6 border-b border-surface-border">
      <div>
        <span class="text-xs font-extrabold uppercase tracking-wider text-nav-muted">Editing Item #<%= @product.id %></span>
        <h1 class="text-2xl sm:text-3xl font-bold text-surface-text tracking-tight mt-0.5">Edit Product</h1>
      </div>

      <!-- Sewing Button Accent Row -->
      <div class="flex items-center gap-1.5">
        <div class="w-5 h-5 rounded-full bg-[#A3C944] border border-[#82A62D] shadow-sm flex items-center justify-center">
          <div class="grid grid-cols-2 gap-0.5">
            <div class="w-0.5 h-0.5 rounded-full bg-[#526B13]"></div>
            <div class="w-0.5 h-0.5 rounded-full bg-[#526B13]"></div>
            <div class="w-0.5 h-0.5 rounded-full bg-[#526B13]"></div>
            <div class="w-0.5 h-0.5 rounded-full bg-[#526B13]"></div>
          </div>
        </div>
        <div class="w-6 h-6 rounded-full bg-periwinkle border border-periwinkle-dark shadow-sm flex items-center justify-center">
          <div class="grid grid-cols-2 gap-0.5">
            <div class="w-0.5 h-0.5 rounded-full bg-[#2D2B4A]"></div>
            <div class="w-0.5 h-0.5 rounded-full bg-[#2D2B4A]"></div>
            <div class="w-0.5 h-0.5 rounded-full bg-[#2D2B4A]"></div>
            <div class="w-0.5 h-0.5 rounded-full bg-[#2D2B4A]"></div>
          </div>
        </div>
        <div class="w-5 h-5 rounded-full bg-[#E34234] border border-[#B82B1F] shadow-sm flex items-center justify-center">
          <div class="grid grid-cols-2 gap-0.5">
            <div class="w-0.5 h-0.5 rounded-full bg-[#5C110A]"></div>
            <div class="w-0.5 h-0.5 rounded-full bg-[#5C110A]"></div>
            <div class="w-0.5 h-0.5 rounded-full bg-[#5C110A]"></div>
            <div class="w-0.5 h-0.5 rounded-full bg-[#5C110A]"></div>
          </div>
        </div>
      </div>
    </div>

    <%= render "form", product: @product %>
  </div>
</div>