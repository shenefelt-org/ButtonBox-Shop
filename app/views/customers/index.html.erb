<div class="max-w-[750px] my-12 mx-auto font-sans text-surface-text px-4 sm:px-0">
  <div class="bg-white p-6 sm:p-8 rounded-xl border border-surface-border shadow-[0_4px_20px_rgba(104,95,214,0.05)]">
    
    <div class="flex items-center justify-between pb-6 mb-6 border-b border-surface-border">
      <h2 class="text-xl font-semibold text-periwinkle-dark tracking-tight m-0">Customers</h2>
      <span class="text-xs font-semibold text-periwinkle bg-periwinkle-light border border-surface-subtle px-3 py-1 rounded-full">
        <%= @customers.count %> Total
      </span>
    </div>

    <div class="overflow-x-auto rounded-lg border border-surface-subtle">
      <table class="min-w-full divide-y divide-surface-border bg-white text-xs">
        <thead class="bg-surface-bg">
          <tr>
            <th class="px-5 py-3 text-left text-[0.725rem] font-semibold uppercase tracking-wider text-nav-text">Name</th>
            <th class="px-5 py-3 text-left text-[0.725rem] font-semibold uppercase tracking-wider text-nav-text">Address</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-surface-border text-surface-text">
          <% @customers.each do |customer| %>
            <tr class="hover:bg-periwinkle-light/50 transition-colors">
              <td class="px-5 py-3.5 font-semibold text-periwinkle-dark whitespace-nowrap">
                <%= customer.name %>
              </td>
              <td class="px-5 py-3.5 text-nav-text whitespace-nowrap">
                <%= customer.address&.street_address %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

  </div>
</div>