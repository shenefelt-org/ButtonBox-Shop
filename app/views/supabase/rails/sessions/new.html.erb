<% content_for :title, "Sign in · ButtonBox" %>

<div class="w-full flex justify-center px-0 sm:px-2 py-6 sm:py-10">
  <div class="w-full max-w-md mx-auto">
    <div class="bg-white border border-surface-border rounded-2xl shadow-[0_8px_30px_rgba(104,95,214,0.08)] p-6 sm:p-8">
      
      <!-- Card Header with Sewing Buttons Accent -->
      <div class="text-center mb-8">
        <div class="flex items-center justify-center gap-2 mb-3">
          <!-- Chartreuse Button -->
          <div class="w-6 h-6 rounded-full bg-[#A3C944] border border-[#82A62D] shadow-sm flex items-center justify-center">
            <div class="grid grid-cols-2 gap-0.5">
              <div class="w-0.5 h-0.5 rounded-full bg-[#526B13]"></div>
              <div class="w-0.5 h-0.5 rounded-full bg-[#526B13]"></div>
              <div class="w-0.5 h-0.5 rounded-full bg-[#526B13]"></div>
              <div class="w-0.5 h-0.5 rounded-full bg-[#526B13]"></div>
            </div>
          </div>
          <!-- Periwinkle Button -->
          <div class="w-7 h-7 rounded-full bg-periwinkle border border-periwinkle-dark shadow-sm flex items-center justify-center">
            <div class="grid grid-cols-2 gap-0.5">
              <div class="w-0.5 h-0.5 rounded-full bg-[#2D2B4A]"></div>
              <div class="w-0.5 h-0.5 rounded-full bg-[#2D2B4A]"></div>
              <div class="w-0.5 h-0.5 rounded-full bg-[#2D2B4A]"></div>
              <div class="w-0.5 h-0.5 rounded-full bg-[#2D2B4A]"></div>
            </div>
          </div>
          <!-- Vermillion Button -->
          <div class="w-6 h-6 rounded-full bg-[#E34234] border border-[#B82B1F] shadow-sm flex items-center justify-center">
            <div class="grid grid-cols-2 gap-0.5">
              <div class="w-0.5 h-0.5 rounded-full bg-[#5C110A]"></div>
              <div class="w-0.5 h-0.5 rounded-full bg-[#5C110A]"></div>
              <div class="w-0.5 h-0.5 rounded-full bg-[#5C110A]"></div>
              <div class="w-0.5 h-0.5 rounded-full bg-[#5C110A]"></div>
            </div>
          </div>
        </div>

        <h1 class="text-2xl sm:text-3xl font-bold text-periwinkle-dark tracking-tight mb-2">
          ButtonBox
        </h1>
        <p class="text-nav-muted text-sm sm:text-base">
          Sign in to your account
        </p>
      </div>

      <%= render "supabase/rails/shared/flash" %>

      <%= form_with url: session_path, data: { turbo: false }, class: "space-y-4" do |form| %>
        <div>
          <%= form.label :email, "Email", class: "block text-sm font-medium text-surface-text mb-1.5" %>
          <%= form.email_field :email,
              required: true,
              autofocus: true,
              autocomplete: "username",
              placeholder: "you@example.com",
              value: params[:email],
              class: "w-full px-4 py-3 bg-surface-bg border border-surface-border rounded-xl text-surface-text placeholder:text-nav-muted focus:outline-none focus:ring-2 focus:ring-periwinkle focus:border-periwinkle transition" %>
        </div>

        <div>
          <%= form.label :password, "Password", class: "block text-sm font-medium text-surface-text mb-1.5" %>
          <%= form.password_field :password,
              required: true,
              autocomplete: "current-password",
              placeholder: "Password",
              maxlength: 72,
              class: "w-full px-4 py-3 bg-surface-bg border border-surface-border rounded-xl text-surface-text placeholder:text-nav-muted focus:outline-none focus:ring-2 focus:ring-periwinkle focus:border-periwinkle transition" %>
        </div>

        <div class="pt-1">
          <%= form.submit "Sign in",
              class: "w-full bg-periwinkle hover:bg-periwinkle-dark text-white font-semibold py-3 rounded-xl transition duration-200 ease-in-out cursor-pointer shadow-sm" %>
        </div>
      <% end %>

      <div class="relative my-6">
        <div class="absolute inset-0 flex items-center" aria-hidden="true">
          <div class="w-full border-t border-surface-border"></div>
        </div>
        <div class="relative flex justify-center text-sm">
          <span class="px-3 bg-white text-nav-muted">or</span>
        </div>
      </div>

      <div class="mb-6">
        <%= render "supabase/rails/oauth/buttons" %>
      </div>

      <div class="space-y-3 text-center text-sm">
        <div>
          <%= link_to "Forgot your password?", new_password_path,
                class: "text-periwinkle hover:text-periwinkle-dark font-medium transition" %>
        </div>
        <div class="text-nav-muted">
          Don't have an account?
          <%= link_to "Sign up", new_registration_path,
                class: "text-periwinkle hover:text-periwinkle-dark font-medium transition" %>
        </div>
      </div>
    </div>
  </div>
</div>