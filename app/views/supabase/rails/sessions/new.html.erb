<div class="min-h-screen bg-gray-50 flex items-center justify-center px-4">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-purple-700 mb-2">ButtonBox</h1>
      <p class="text-gray-600 text-sm">Sign in to your account</p>
    </div>
    <%= render "supabase/rails/shared/flash" %>
    <%= form_with url: session_path, data: { turbo: false }, class: "space-y-4" do |form| %>
      <div>
        <%= form.email_field :email, 
            required: true, 
            autofocus: true, 
            autocomplete: "username", 
            placeholder: "Email address",
            value: params[:email],
            class: "w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-purple-600 focus:border-transparent transition" %>
      </div>
      <div>
        <%= form.password_field :password, 
            required: true, 
            autocomplete: "current-password", 
            placeholder: "Password",
            maxlength: 72,
            class: "w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-purple-600 focus:border-transparent transition" %>
      </div>
      <div class="pt-2">
        <%= form.submit "Sign in", class: "w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-3 rounded-lg transition duration-200 ease-in-out" %>
      </div>
    <% end %>
    <div class="relative my-6">
      <div class="absolute inset-0 flex items-center">
        <div class="w-full border-t border-gray-300"></div>
      </div>
      <div class="relative flex justify-center text-sm">
        <span class="px-2 bg-gray-50 text-gray-500">or</span>
      </div>
    </div>
    <div class="mb-6">
      <%= render "supabase/rails/oauth/buttons" %>
    </div>
    <div class="space-y-2 text-center text-sm">
      <div>
        <%= link_to "Forgot your password?", new_password_path, class: "text-purple-600 hover:text-purple-700 font-medium transition" %>
      </div>
      <div class="text-gray-600">
        Don't have an account?
        <%= link_to "Sign up", new_registration_path, class: "text-purple-600 hover:text-purple-700 font-medium transition" %>
      </div>
    </div>
  </div>
</div>