<% content_for :title, "Forgot password · ButtonBox" %>

<div class="w-full min-h-[calc(100vh-8rem)] flex items-center justify-center">
  <div class="w-full max-w-md mx-auto">
    <div class="bg-white border border-surface-border rounded-2xl shadow-[0_8px_30px_rgba(104,95,214,0.08)] p-6 sm:p-8">
      <div class="text-center mb-8">
        <h1 class="text-2xl sm:text-3xl font-bold text-periwinkle-dark tracking-tight mb-2">
          Forgot your password?
        </h1>
        <p class="text-nav-muted text-sm sm:text-base">
          Enter your email and we’ll send reset instructions.
        </p>
      </div>

      <%= render "supabase/rails/shared/flash" %>

      <%= form_with url: passwords_path, data: { turbo: false }, class: "space-y-4" do |form| %>
        <div>
          <%= form.label :email, "Email", class: "block text-sm font-medium text-surface-text mb-1.5" %>
          <%= form.email_field :email,
              required: true,
              autofocus: true,
              autocomplete: "username",
              placeholder: "you@example.com",
              value: params[:email],
              class: "w-full px-4 py-3 bg-surface-bg border border-surface-border rounded-xl text-surface-text placeholder:text-nav-muted focus:outline-none focus:ring-2 focus:ring-periwinkle focus:border-periwinkle transition" %>
        </div>

        <div class="pt-1">
          <%= form.submit "Email reset instructions",
              class: "w-full bg-periwinkle hover:bg-periwinkle-dark text-white font-semibold py-3 rounded-xl transition duration-200 ease-in-out cursor-pointer shadow-sm" %>
        </div>
      <% end %>

      <div class="mt-6 text-center text-sm">
        <%= link_to "Back to sign in", new_session_path,
              class: "text-periwinkle hover:text-periwinkle-dark font-medium transition" %>
      </div>
    </div>
  </div>
</div>