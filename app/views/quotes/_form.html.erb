<%= form_with(model: quote, class: "space-y-6") do |form| %>
  <% if quote.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl text-sm mb-6">
      <h2 class="font-bold mb-1"><%= pluralize(quote.errors.count, "error") %> prohibited this quote from being saved:</h2>
      <ul class="list-disc list-inside text-xs space-y-1">
        <% quote.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Quote Number Auto-Generation Banner -->
  <div class="bg-surface-bg border border-surface-border rounded-xl p-4 flex items-center justify-between text-xs text-nav-muted">
    <span class="font-semibold text-surface-text">Quote Number</span>
    <span class="font-bold text-periwinkle-dark bg-periwinkle/10 px-2.5 py-1 rounded-md border border-periwinkle/20">Auto-Generated on Save</span>
  </div>

  <!-- Customer Dropdown -->
  <div>
    <%= form.label :customer_id, "Customer", class: "block text-xs font-bold uppercase tracking-wider text-nav-muted mb-2" %>
    <%= form.collection_select :customer_id,
        @customers,
        :id,
        :first_name,
        { prompt: "Select a Customer..." },
        { required: true, class: "w-full px-4 py-3 bg-surface-bg border border-surface-border rounded-xl text-surface-text focus:outline-none focus:ring-2 focus:ring-periwinkle focus:border-periwinkle transition text-sm cursor-pointer" } %>
  </div>

  <!-- Total Amount ($) -->
  <div>
    <%= form.label :total_amount, "Total Amount ($)", class: "block text-xs font-bold uppercase tracking-wider text-nav-muted mb-2" %>
    <div class="relative rounded-xl shadow-sm">
      <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4">
        <span class="text-nav-muted text-sm font-semibold">$</span>
      </div>
      <%= form.number_field :total_amount,
          step: "0.01",
          min: "0",
          placeholder: "0.00",
          required: true,
          class: "w-full pl-8 pr-4 py-3 bg-surface-bg border border-surface-border rounded-xl text-surface-text placeholder:text-nav-muted focus:outline-none focus:ring-2 focus:ring-periwinkle focus:border-periwinkle transition text-sm" %>
    </div>
  </div>

  <!-- Approved Switch -->
  <div class="flex items-center gap-3 pt-2">
    <%= form.check_box :approved, class: "w-4 h-4 text-periwinkle bg-surface-bg border-surface-border rounded focus:ring-periwinkle focus:ring-2 cursor-pointer" %>
    <%= form.label :approved, "Quote Approved", class: "text-sm font-semibold text-surface-text cursor-pointer" %>
  </div>

  <!-- Submit & Cancel Actions -->
  <% cancel_path = quote.persisted? ? quote_path(quote) : quotes_path %>

  <div class="pt-6 border-t border-surface-border flex items-center justify-end gap-3">
    <%= link_to "Cancel", cancel_path, class: "text-xs text-nav-muted hover:text-surface-text font-semibold px-4 py-2 transition no-underline" %>
    
    <button type="submit" class="inline-flex items-center gap-2.5 bg-periwinkle hover:bg-periwinkle-dark text-white font-semibold px-6 py-2.5 rounded-xl transition shadow-sm text-sm cursor-pointer border-0">
      <span class="w-4 h-4 rounded-full bg-white/20 border border-white/40 flex items-center justify-center shrink-0">
        <span class="grid grid-cols-2 gap-0.5">
          <span class="w-0.5 h-0.5 rounded-full bg-white"></span>
          <span class="w-0.5 h-0.5 rounded-full bg-white"></span>
          <span class="w-0.5 h-0.5 rounded-full bg-white"></span>
          <span class="w-0.5 h-0.5 rounded-full bg-white"></span>
        </span>
      </span>
      <span>Save Quote</span>
    </button>
  </div>
<% end %>